{
  "permissions": {
    "allow": [
      "Bash",
      "PowerShell",
      "Python",
      "Read",
      "Write",
      "Edit",
      "Glob",
      "Grep",
      "Agent",
      "WebFetch",
      "WebSearch",
      "NotebookEdit",
      "TaskCreate",
      "TaskUpdate",
      "TaskGet",
      "TaskList",
      "TaskOutput",
      "TaskStop",
      "mcp__ide__executeCode",
      "mcp__ide__getDiagnostics",
      "mcp__azure",
      "mcp__ado-highwaysengland",
      "mcp__ado-cloudaande"
    ],
    "deny": []
  },
  "awaySummaryEnabled": false,
  "model": "opus",
  "modelSettings": {
    "claude-opus-5-5": {
      "effortLevel": "medium"
    },
    "claude-sonnet-5-5": {
      "effortLevel": "medium"
    }
  },
  "statusLine": {
    "type": "command",
    "command": "node \"%USERPROFILE%/.claude/statusline.js\""
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell|WebFetch|mcp__github__.*|mcp__ado-.*",
        "hooks": [
          {
            "type": "command",
            "command": "node \"%USERPROFILE%/.claude/hooks/guardrails.js\"",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "env": {
    "CLAUDE_CODE_PLUGIN_DIRS": "~/.claude/mods/lifecycle-band",
    "CLAUDE_CODE_AUTO_COMPACT_WINDOW": "200000"
  },
  "respectGitignore": false,
  "skipDangerousModePermissionPrompt": true,
  "switchModelsOnFlag": false
}
