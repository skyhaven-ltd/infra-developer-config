<Window x:Class="CloudContext.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Cloud Connect" Height="720" Width="1120" MinHeight="620" MinWidth="900"
        WindowStartupLocation="CenterScreen" Background="#F4F6F8" Icon="Assets/cloud-connect.ico">
  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="320" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>

    <Border Grid.Column="0" Background="#172A3A" Padding="18">
      <DockPanel>
        <StackPanel DockPanel.Dock="Top">
          <TextBlock Text="Cloud Connect" Foreground="White" FontSize="24" FontWeight="SemiBold" />
          <TextBlock Text="Isolated customer identities" Foreground="#B7C8D6" Margin="0,3,0,18" />
        </StackPanel>
        <UniformGrid DockPanel.Dock="Bottom" Columns="4" Margin="0,12,0,0">
          <Button Content="Add" Click="AddProfile_Click" MinWidth="0" Padding="5,7" Margin="0,0,3,0" />
          <Button x:Name="EditProfileButton" Content="Edit" Click="EditProfile_Click" MinWidth="0" Padding="5,7" Margin="1,0,2,0" />
          <Button x:Name="RemoveProfileButton" Content="Remove" Click="RemoveProfile_Click" MinWidth="0" Padding="5,7" Margin="2,0,1,0" />
          <Button x:Name="ValidateEveryProfileButton" Content="Validate all" Click="ValidateEveryProfile_Click" MinWidth="0" Padding="5,7" Margin="3,0,0,0" ToolTip="Validate every identity and all of its configured connections" />
        </UniformGrid>
        <TreeView x:Name="ProfilesTree" SelectedItemChanged="ProfilesTree_SelectedItemChanged"
                  BorderThickness="0" Background="#213C50" Foreground="White" Padding="3">
          <TreeView.ItemContainerStyle>
            <Style TargetType="TreeViewItem">
              <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
              <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}" />
              <Setter Property="Foreground" Value="White" />
              <Setter Property="Padding" Value="2" />
            </Style>
          </TreeView.ItemContainerStyle>
          <TreeView.ItemTemplate>
            <HierarchicalDataTemplate ItemsSource="{Binding Children}">
              <TextBlock Text="{Binding Name}" Foreground="White" FontSize="15" />
            </HierarchicalDataTemplate>
          </TreeView.ItemTemplate>
        </TreeView>
      </DockPanel>
    </Border>

    <Grid Grid.Column="1" Margin="26,22">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>

      <Grid Grid.Row="0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <StackPanel>
          <TextBlock x:Name="ProfileNameText" Text="Select a profile" FontSize="27" FontWeight="SemiBold" Foreground="#172A3A" />
          <TextBlock x:Name="IdentityText" Text="Add a profile to get started." Foreground="#526879" Margin="0,4,0,0" />
          <TextBlock x:Name="ActiveProfileText" Text="No active profile." Foreground="#52738A" FontWeight="SemiBold" Margin="0,4,0,0" />
        </StackPanel>
        <Button x:Name="ValidateSelectedButton" Grid.Column="1" Content="Validate selected" Click="ValidateSelected_Click" VerticalAlignment="Top" />
      </Grid>

      <WrapPanel Grid.Row="1" Margin="0,22,0,10">
        <Button x:Name="AddConnectionButton" Content="Add connection" Click="AddConnection_Click" />
        <Button x:Name="EditConnectionButton" Content="Edit selected" Click="EditConnection_Click" IsEnabled="False" />
        <Button x:Name="RemoveConnectionButton" Content="Remove selected" Click="RemoveConnection_Click" IsEnabled="False" />
        <Button x:Name="MakeActiveButton" Content="Make active" Click="MakeActive_Click" />
        <Button x:Name="AzureSignInButton" Content="Sign in to Azure" Click="AzureSignIn_Click" />
        <Button x:Name="GitHubSignInButton" Content="Sign in to GitHub" Click="GitHubSignIn_Click" />
        <Button x:Name="DataverseSignInButton" Content="Connect Dataverse" Click="DataverseSignIn_Click" />
        <Button x:Name="OpenPowerShellButton" Content="Open scoped PowerShell" Click="OpenPowerShell_Click" />
      </WrapPanel>

      <Border Grid.Row="2" Background="White" BorderBrush="#D5DEE5" BorderThickness="1" CornerRadius="4" Padding="1">
        <DataGrid x:Name="ConnectionsGrid" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                  SelectionChanged="ConnectionsGrid_SelectionChanged"
                  HeadersVisibility="Column" GridLinesVisibility="Horizontal" BorderThickness="0">
          <DataGrid.Columns>
            <DataGridTextColumn Header="Connection" Binding="{Binding Kind}" Width="130" />
            <DataGridTextColumn Header="Target" Binding="{Binding Target}" Width="2*" />
            <DataGridTextColumn Header="State" Binding="{Binding State}" Width="125" />
            <DataGridTextColumn Header="Detail" Binding="{Binding Detail}" Width="3*" />
          </DataGrid.Columns>
        </DataGrid>
      </Border>

      <Border Grid.Row="3" Background="#E8EDF1" Padding="10" Margin="0,12,0,0" CornerRadius="3">
        <TextBlock x:Name="ActivityText" Text="Ready." Foreground="#344B5E" />
      </Border>
    </Grid>
  </Grid>
</Window>
